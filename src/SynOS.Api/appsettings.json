{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 524288000
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SynOSDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Secret": "REPLACE_THIS_WITH_A_REAL_SECRET_REPLACE_THIS_WITH_A_REAL_SECRET",
    "Issuer": "SynOS.Api",
    "Audience": "SynOS.App",
    "ExpiryMinutes": 1440,
    "RefreshTokenExpiryDays": 7
  },
  "FileStorage": {
    "BasePath": "C:\\SynOS_Files",
    "PublicBaseUrl": "http://127.0.0.1:59999/files"
  },
  "Pacs": {
    "RootPath": "D:\\SynOS\\Pacs"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "SecureLink": {
    "BaseUrl": "http://127.0.0.1:59999/api/v1/public/reports",
    "PublicBaseUrl": "https://labels-amendments-spice-submissions.trycloudflare.com"
  }
}