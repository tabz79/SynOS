<Window x:Class="SynOS.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SynOS Server Operations Console" Height="620" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SynOS Operations Console" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#3B82F6" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                            <TextBlock Text="v1.5.2" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="On-Premise Diagnostic Server Control &amp; Real-Time Health Monitor" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="OverallStatusBorder" Background="#065F46" CornerRadius="20" Padding="14,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="OverallStatusDot" Width="10" Height="10" Fill="#34D399" Margin="0,0,8,0"/>
                        <TextBlock x:Name="OverallStatusText" Text="SYSTEM ONLINE" FontSize="12" FontWeight="Bold" Foreground="#ECFDF5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Real System Health Cards Grid -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Windows Service -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="WINDOWS SERVICE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="TBZSynOSService" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,8"/>
                    <Border x:Name="ServiceStatusBorder" Background="#065F46" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                        <TextBlock x:Name="ServiceStatusText" Text="RUNNING" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 2: SQL Database -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="DATABASE ENGINE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="SQL Server (SYNOS)" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,8"/>
                    <Border x:Name="DbStatusBorder" Background="#065F46" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                        <TextBlock x:Name="DbStatusText" Text="CONNECTED" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 3: Web API Endpoint -->
            <Border Grid.Column="4" Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="WEB API ENDPOINT" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="http://localhost:59999" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,8"/>
                    <Border x:Name="ApiStatusBorder" Background="#065F46" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                        <TextBlock x:Name="ApiStatusText" Text="HEALTHY (200 OK)" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Actions Panel -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnStart" Content="▶  Start Server" Click="BtnStart_Click" Width="130" Height="36" Margin="0,0,8,0" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnStop" Content="⏹  Stop Server" Click="BtnStop_Click" Width="130" Height="36" Margin="0,0,8,0" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnRestart" Content="🔄  Restart Server" Click="BtnRestart_Click" Width="140" Height="36" Margin="0,0,8,0" Background="#3B82F6" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnOpenBrowser" Content="🌐  Open SynOS (/login)" Click="BtnOpenBrowser_Click" Width="180" Height="36" Background="#8B5CF6" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Log Stream Viewer -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="LIVE SERVER LOG STREAM" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <Button x:Name="BtnRefreshLogs" Content="Refresh Logs" Click="BtnRefreshLogs_Click" HorizontalAlignment="Right" Background="#334155" Foreground="#E2E8F0" Padding="8,2" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                </Grid>
                <TextBox Grid.Row="1" x:Name="TxtLogs" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#020617" Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" Padding="10" TextWrapping="NoWrap" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="4" Text="SynOS Diagnostic Lab Operations Console • TBZ Labs • Auto-Refreshes Health Every 5 Seconds" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
</Window>
